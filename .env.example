# ==============================================================================
# Open Business Application Framework (OBAF) - Environment Configuration
# ==============================================================================

# Server Network Settings
OBAF_SERVER__HOST=127.0.0.1
OBAF_SERVER__PORT=8080
# Or standard cloud deployment PORT:
# PORT=8080

# Database Connection (Zero-dependency SQLite by default)
DATABASE_URL=sqlite://data/obaf.db?mode=rwc

# For PostgreSQL in production:
# DATABASE_URL=postgres://obaf_user:obaf_secret@localhost:5432/obaf_db

# Security & Authentication
OBAF_SECURITY__JWT_SECRET=dev_secret_please_change_in_production_987654321
OBAF_SECURITY__TOKEN_EXPIRY_HOURS=24

# Rust Tracing & Log Filter
RUST_LOG=info,obaf_server=debug,obaf_api=debug,sea_orm=warn
