# ==============================================================================
# Open Business Application Framework (OBAF) - Environment Configuration
# ==============================================================================
# Simplified Zero-Friction Deployment:
# Once deployed with the database connected and Super Admin credentials set,
# all other settings (organizations, API modules gating, branding, currency,
# session expiry, Google SSO, etc.) are configured dynamically via the
# Super Admin Console at http://<host>:8080/admin
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (Required)
# ------------------------------------------------------------------------------
# Embedded SQLite (Default for single-server, VPS, and Docker deployments):
DATABASE_URL=sqlite:///app/data/obaf.db?mode=rwc

# Enterprise PostgreSQL (For multi-node clustered deployments):
# DATABASE_URL=postgres://obaf_user:strong_password@postgres.internal:5432/obaf_production

# ------------------------------------------------------------------------------
# 2. Platform Super Administrator (Required)
# ------------------------------------------------------------------------------
# Root super administrator credentials for the platform console (/admin).
# Note: Both flat (SUPERADMIN_*) and prefixed (OBAF_SUPERADMIN_*) forms are supported.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_this_to_a_secure_admin_password

# ------------------------------------------------------------------------------
# 3. Optional: Google SSO for Super Admin (Can also be set in Super Admin UI)
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
