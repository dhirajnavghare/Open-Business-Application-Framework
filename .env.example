# ==============================================================================
# Open Business Application Framework (OBAF) - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Settings
# ------------------------------------------------------------------------------
# Bind host and port. Both flat and nested (OBAF_SERVER__*) formats are supported.
OBAF_SERVER__HOST=0.0.0.0
OBAF_SERVER__PORT=8080
# Cloud PaaS aliases:
# HOST=0.0.0.0
# PORT=8080

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# Zero-dependency embedded SQLite (Default for development & edge appliances):
DATABASE_URL=sqlite://data/obaf.db?mode=rwc

# Production Clustered PostgreSQL (Required for high-availability enterprise profiles):
# DATABASE_URL=postgres://obaf_user:strong_production_password@postgres.internal:5432/obaf_production

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# High-entropy secret key for HMAC-SHA256 JWT signing (minimum 32 characters in production)
OBAF_SECURITY__JWT_SECRET=dev_secret_please_change_in_production_987654321
# Security token validity duration in hours
OBAF_SECURITY__TOKEN_EXPIRY_HOURS=24
# Cloud alias:
# JWT_SECRET=production_ultra_secure_jwt_secret_key_random_32_bytes_min

# ------------------------------------------------------------------------------
# 4. Background Worker Settings
# ------------------------------------------------------------------------------
# Maintenance & reconciliation sweep interval in seconds (used by obaf-worker)
OBAF_WORKER_INTERVAL_SECS=30

# ------------------------------------------------------------------------------
# 5. Logging & Tracing
# ------------------------------------------------------------------------------
# Standard Rust tracing filter (options: trace, debug, info, warn, error)
RUST_LOG=info,obaf_server=info,obaf_api=info,obaf_database=info,tower_http=info

# ------------------------------------------------------------------------------
# 6. Platform Super Administrator & Google SSO
# ------------------------------------------------------------------------------
# Single designated platform root super administrator (accessed at /admin or /superadmin)
OBAF_SUPERADMIN_EMAIL=admin@obaf.local
OBAF_SUPERADMIN_PASSWORD=admin123
# Optional Google Identity Services OAuth 2.0 Client ID for Google SSO:
# OBAF_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# OBAF_GOOGLE_CLIENT_SECRET=your-google-client-secret
# OBAF_SUPERADMIN_GOOGLE_EMAIL=admin@obaf.local
