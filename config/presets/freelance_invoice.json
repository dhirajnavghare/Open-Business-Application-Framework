{
  "preset_id": "freelance_invoice",
  "name": "Freelancer Invoice & Expense Tracker",
  "version": "1.0.0",
  "description": "Client profiles, log billable hours & milestones, downloadable invoices, and payment tracking",
  "active_modules": [
    "customers",
    "catalog",
    "orders",
    "payments",
    "billing"
  ],
  "default_tax_slabs": [
    { "name": "Zero Tax (Export / Exempt)", "rate": 0.00 },
    { "name": "GST 18% (Technical & Creative Services)", "rate": 0.18 }
  ],
  "workflow_states": [
    "draft",
    "sent_to_client",
    "partially_paid",
    "paid_in_full",
    "overdue",
    "written_off"
  ],
  "custom_field_schemas": {
    "order": {
      "project_name": "string",
      "billable_hours": "number",
      "hourly_rate": "number",
      "po_reference": "string",
      "payment_terms": "string"
    }
  }
}
