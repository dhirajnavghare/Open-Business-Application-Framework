{
  "name": "@obaf/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript Client SDK for Open Business Application Framework (OBAF)",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "keywords": [
    "obaf",
    "pos",
    "billing",
    "headless",
    "erp",
    "typescript"
  ],
  "author": "OBAF Contributors",
  "license": "MIT OR Apache-2.0"
}
